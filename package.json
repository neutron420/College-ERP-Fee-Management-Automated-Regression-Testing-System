{
  "name": "fee-testing",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "bun --filter @repo/database db:generate",
    "db:push": "bun --filter @repo/database db:push",
    "db:migrate": "bun --filter @repo/database db:migrate",
    "db:seed": "bun --filter @repo/database db:seed",
    "db:studio": "bun --filter @repo/database db:studio",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test tests/e2e/ui-flow.spec.ts --headed",
    "test:endpoints": "bun run scripts/verify-all-endpoints.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.13.4",
    "prettier": "3.9.6",
    "turbo": "^2.11.2",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
